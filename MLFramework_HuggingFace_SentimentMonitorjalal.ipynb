      "cell_type": "code",
      "source": [
        "!pip -q install transformers\n",
        "\n"
      ],
      "metadata": {
        "id": "1UfP8k3oxqx3"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from transformers import pipeline\n",
        "\n",
        "# Initialize the sentiment analysis pipeline\n",
        "sentiment = pipeline(\"sentiment-analysis\")\n",
        "\n",
        "print(\"--- 1. E-Commerce & Product Review Filter ---\")\n",
        "product_reviews = [\n",
        "    \"The product stopped working after just two days of use.\",\n",
        "    \"Exceeded my expectations, absolutely wonderful quality!\"\n",
        "]\n",
        "for text in product_reviews:\n",
        "    print(f\"Text: '{text}'\\nResult: {sentiment(text)}\\n\")\n",
        "\n",
        "\n",
        "print(\"--- 2. Video Game Stream Chat Moderator ---\")\n",
        "chat_messages = [\n",
        "    \"This streamer is the absolute worst player I have ever seen.\",\n",
        "    \"Amazing gameplay everyone, GG!\"\n",
        "]\n",
        "for text in chat_messages:\n",
        "    print(f\"Text: '{text}'\\nResult: {sentiment(text)}\\n\")\n",
        "\n",
        "\n",
        "print(\"--- 3. Healthcare Patient Feedback Tracker ---\")\n",
        "patient_feedback = [\n",
        "    \"The wait time in the emergency room was completely unacceptable.\",\n",
        "    \"The nursing staff was incredibly compassionate and helpful.\"\n",
        "]\n",
        "for text in patient_feedback:\n",
        "    print(f\"Text: '{text}'\\nResult: {sentiment(text)}\\n\")\n",
        "\n",
        "\n",
        "print(\"--- 4. Hotel Booking & Guest Churn Evaluator ---\")\n",
        "guest_surveys = [\n",
        "    \"Our room was dusty and the air conditioning unit was broken.\",\n",
        "    \"We loved the ocean view and the concierge was very attentive.\"\n",
        "]\n",
        "for text in guest_surveys:\n",
        "    print(f\"Text: '{text}'\\nResult: {sentiment(text)}\\n\")\n",
        "\n",
        "\n",
        "print(\"--- 5. EdTech Student Engagement Monitor ---\")\n",
        "student_posts = [\n",
        "    \"I am completely lost on this week's module and need help.\",\n",
        "    \"The lecture videos made these complex algorithms easy to understand!\"\n",
        "]\n",
        "for text in student_posts:\n",
        "    print(f\"Text: '{text}'\\nResult: {sentiment(text)}\\n\")"
      ],
